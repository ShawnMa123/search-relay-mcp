# SearchRelay MCP environment.
# Copy to .env for local Compose runs and fill in real values; never commit .env.
# The binary itself does not read .env files: inject variables via Compose or your shell.

# Address the process listens on in the container.
# Host runs keep the loopback default 127.0.0.1:18081; Compose overrides this to 0.0.0.0:18081
# and publishes only 127.0.0.1:18081 on the host.
LISTEN_ADDR=127.0.0.1:18081

# Bearer token required on every /mcp request. 32-256 characters from [A-Za-z0-9_-].
# Generate a random token; do not reuse a provider key.
MCP_BEARER_TOKEN=

# Ordered comma-separated subset of: keepable,tinyfish,anysearch.
# Unset means the default keepable,tinyfish,anysearch. Only enabled providers need keys.
SEARCH_PROVIDERS=keenable,tinyfish,anysearch

KEENABLE_API_KEY=
TINYFISH_API_KEY=
ANYSEARCH_API_KEY=